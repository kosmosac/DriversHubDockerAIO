# Address and port on the Docker host. Use this address for the external proxy.
HUB_BIND=127.0.0.1:18080

# Uncomment when this deployment terminates HTTPS with compose.direct.yaml.
# COMPOSE_FILE=compose.direct.yaml

# Uncomment to resolve visitor countries locally when Cloudflare is not used.
# COMPOSE_PROFILES=geoip

# Public domain for compose.direct.yaml. It is not used by compose.yaml.
HUB_DOMAIN=hub.example.com

# Concurrent compiler jobs for the Nuitka backend build. Use 1 on a small host.
BACKEND_BUILD_JOBS=2

# Use source-runtime only for development and short-term testing.
BACKEND_BUILD_TARGET=runtime

DB_NAME=drivershub
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password

# Public URL of the backend client configuration endpoint.
VITE_CONFIG_URL=https://hub.example.com/api/client/config/global

# Public hCaptcha site key for the Hub domain.
VITE_HCAPTCHA_SITEKEY=replace-with-your-hcaptcha-site-key

# Base URL of the map tile service. The default uses the upstream service.
VITE_MAP_BASE_URL=https://map.charlws.com

# Optional ets2map-compatible live player endpoint. The former hardcoded URL
# was https://tracker.ets2map.com/v3/area. The frontend automatically adds
# x1, y1, x2, y2, and server query parameters. An absolute URL or same-origin
# path such as /__live-map can be used. Leave empty to disable live player
# positions and heatmaps without disabling the maps themselves.
VITE_LIVE_MAP_URL=
