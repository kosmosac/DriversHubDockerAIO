# Address and port on the Docker host. Use this address for the external proxy.
HUB_BIND=127.0.0.1:18080

# Public domain for compose.direct.yaml. It is not used by compose.yaml.
HUB_DOMAIN=hub.example.com

DB_NAME=drivershub
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password

# Public URL of the backend client configuration endpoint.
VITE_CONFIG_URL=https://hub.example.com/api/client/config/global

# Public hCaptcha site key for the Hub domain.
VITE_HCAPTCHA_SITEKEY=replace-with-your-hcaptcha-site-key

# Use an empty value when the frontend and its assets use the same origin.
ASSETS_BASE=

VITE_USE_MULTIHUB=false
VITE_MULTIHUB_DISCOVERY=
